{
  "name": "concurso-questoes",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "predev": "node scripts/preparar-dados.mjs",
    "build": "vite build",
    "prebuild": "node scripts/preparar-dados.mjs",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc -p jsconfig.json",
